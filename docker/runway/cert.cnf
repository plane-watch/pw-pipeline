[ req ]
default_bits       = 2048
prompt             = no
default_md         = sha256
distinguished_name = dn
req_extensions     = req_ext

[ dn ]
C  = AU
ST = Western Australia
L  = Perth
O  = Plane.Watch
OU = Runway
CN = feed.plane.watch

[ req_ext ]
subjectAltName = @alt_names

[ alt_names ]
DNS.1 = feed.plane.watch
DNS.2 = beta.plane.watch
IP.1  = 127.0.0.1
